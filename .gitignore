# Cuttle — right-click file converter

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.exe
*.dll
*.obj
*.o

# Virtual environments
.venv/
venv/
env/

# Vendored external tools (downloaded by scripts/fetch_tools.py)
vendor/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Test fixtures (generated by tests/make_fixtures.py)
tests/fixtures/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log

# mypy cache
.mypy_cache/

# pytest cache
.pytest_cache/

# ruff cache
.ruff_cache/

# Coverage
htmlcov/
.coverage
.coverage.*
coverage.xml

# Planning documents (large binary, keep locally)
*.pdf
extracted_docs.txt
